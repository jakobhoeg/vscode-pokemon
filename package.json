                                                    "fire_stone",
                                                    "water_stone",
                                                    "thunder_stone",
                                                    "leaf_stone",
                                                    "moon_stone",
                                                    "sun_stone",
                                                    "shiny_stone",
                                                    "dusk_stone",
                                                    "dawn_stone",
                                                    "ice_stone",
                                                    "oval_stone",
                                                    "auspicious_armor",
                                                    "malicious_armor",
                                                    "tart_apple",
                                                    "syrupy_apple",
                                                    "cracked_pot",
                                                    "chipped_pot",
                                                    "unremarkable_teacup",
                                                    "masterpiece_teacup",
                                                    "black_augurite",
                                                    "peat_block",
                                                    "leaders_crest",
                                                    "scroll_of_darkness",
                                                    "scroll_of_waters",
                                                    "metal_coat",
